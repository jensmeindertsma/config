# ── Gruvbox Yellow ───────────────────
font=JetBrainsMono Nerd Font 10
background-color=#d79921
text-color=#282828
border-size=0
border-radius=8

# ── Layout ───────────────────────────
width=350
height=110
padding=12
margin=12
anchor=top-right
layer=overlay

# ── Behavior ─────────────────────────
default-timeout=2500
max-visible=5
max-history=20
group-by=app-name
sort=+time

# ── Icons ────────────────────────────
icons=1
max-icon-size=36

# ── Progress ─────────────────────────
progress-color=over #282828

# ── Misc ─────────────────────────────
markup=1
actions=1

# ── Urgency ──────────────────────────
[urgency=low]
background-color=#fabd2f
text-color=#282828
border-color=#b57614

[urgency=normal]
background-color=#d79921
text-color=#282828
border-color=#b57614

[urgency=high]
background-color=#cc241d
text-color=#fbf1c7
border-color=#9d0006
default-timeout=0
